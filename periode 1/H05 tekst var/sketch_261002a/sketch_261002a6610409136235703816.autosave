int opdracht = 0;
String string1 = "string1";
String string2 = "string2";
String string3 = "string3";
String string4 = string1 + "" + string2  + "" + string3 + "" + "string4";

int bmiX = 90;
int bmiY = 120;
int bmiWidth = 600;
int bmiHeight = 600;
int gewicht = 0;
int lengte = 0;
int bmi = gewicht / (lengte*lengte);

float tempMouse = 0;

void setup(){
size(1440,900);
background(255,255,255);
}

void draw(){
  //noStroke();
background(255,255,255);

  textSize(45);

  switch(opdracht){
    case 1:
      opdrachtStringsAanElkaar();
      break;
    case 2:
      watLangZeg();
      break;
    case 3:
      //opdrachtDriehoeken();
      break;
    case 4:
      //opdrachtDriehoeken();
      break;
  }

  rect(bmiX, bmiY, bmiWidth, bmiHeight);
  fill(mouseX, mouseY, 0);
  rect(bmiX + 20, bmiY + 20, bmiWidth - 40, bmiHeight -40);
  text(bmi, mouseX - (45 * 7), mouseY);
  text(lengte, mouseX - (45 * 7), mouseY + 20);
  text(gewicht, mouseX - (45 * 7), mouseY - 20);

  if(key ==  '1'){
    opdracht = 1;
  }
  if(key ==  '2'){
    opdracht = 2;
  }
  if(key ==  '3'){
    opdracht = 3;
  }
  if(key ==  '4'){
    opdracht = 4;
  }


  textSize(25);
  fill(0,0,0);
  text("1 voor driehoeken\n 2 voor envelop \n 3 voor lijnen\n 4 voor Nederlandse Vlag",width - 295,90);
  text(opdracht,width - 595,90);
}

void opdrachtStringsAanElkaar(){
  fill(mouseX, mouseY, 0);
  text(string4, mouseX - (45 * 7), mouseY);
  //tempMouse = mouseX/mouseY;
}

void watLangZeg(){
  int wat = 30;
  String strong = "??? me confus";
  textSize(50);
  text(wat + " " + strong,width/2 - 150,height/2);
}

