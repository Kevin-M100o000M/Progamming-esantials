int num1 = (100 * 5);
int num2 = (150 * 5);

int num3 = (80 * 3);
int num4 = (100 * 3);
int num5 = (120 * 3);
int num6 = (150 * 3);
int opdracht = 0;

void setup(){
size(1440,900);
background(255,255,255);
}

void draw(){
  //noStroke();

  switch(opdracht){
    case 1:
      opdrachtDriehoeken();
      break;
    case 2:
      opdrachtEnvelop();
      break;
    case 3:
      break;
    case 4:
      break;
    default:
      fill(0,0,0);
      textSize(45);
      text("1 voor driehoeken\n 2 voor envelop",90,90);
      break;
  }

  if(key ==  '1'){
    opdracht = 1;
  }
  else if(key ==  '2'){
    opdracht = 2;
  }
  else{
    opdracht = 999;
  }

  //line(num1,num1,num2,num2);
  //stroke(30,200,20);
  //line(num2,num1,num1,num2);
  //stroke(30,20,200);
  //line(num3,num1,num3,num2);
}

void opdrachtDriehoeken(){
  textSize(45);
  strokeWeight(2);
  stroke(200,10,20);
  //triangle(100,100,150,150,100,150);
  fill(120,0,190);
  triangle(num1,num1,num2,num2,num1,num2);
  textSize(45);
  fill(0,0,0);
  text("Rechhoekige driehoek",(num2 - 240),(num2 + 40));


  fill(120,0,190);
  strokeWeight(2);
  stroke(10,200,20);
  triangle(num4,num4,num3,num6,num5,num6);
  fill(0,0,0);
  textSize(25);
  text("Gelijke benige driehoek",(num6 - 240),(num6 + 40));
  }

void opdrachtEnvelop(){
  rect(100,90,200,100);
  triangle(100,90,300,90,200,165);
}
