int score = 0;
int opdracht = 0;
int leeftijd;
int konijn;

void setup(){
size(1440,900);
background(255,255,255);
}

void draw(){
  background(0,0,0);

  fill(255,255,255);
  textSize(45);
  text("Opdracht: " + opdracht + "\n",0 + 60,60);
  textSize(30);
  text("1 check leeftijd\n 2 voor korteNotatie \n 3 voor secondenOpdracht \n 4 voor gemideldeOpdracht \n",0 + 60,120);

    switch(opdracht){
    case 1:
      checkLeeftijd();
      break;
    case 2:
      operators();
      break;
  }

  if(key ==  '1'){
    opdracht = 1;
  }
  if(key ==  '2'){
    opdracht = 2;
  }
  if(key ==  '3'){
    opdracht = 3;
  }
  if(key ==  '4'){
    opdracht = 4;
  }


}

void checkLeeftijd(){
  if(leeftijd >= 18){
    textSize(30);
    text("leeftijd is 18 of hoger\n",width/2,520);
  }
  else{
    textSize(30);
    text("leeftijd is lager dan 18\n",width/2,520);
  }
}

void operators(){
  konijn = 30;
  text(">>>>>> TEKST <<<<<\n",width/2 - 60,520);
  if(konijn == opdracht){
    textSize(30);
    text("leeftijd is lager dan 18\n",width/2,520);
  }
  if(konijn >= 4){
    textSize(30);
    text("leeftijd is lager dan 18\n",width/2,520);
  }
  if(konijn < 2000 && konijn   => 40){
    textSize(30);
    text("AND OPetor\n",width/2,520);
  }
  if(konijn != null){
    textSize(30);
    text("Konijn is\n",width/2,520);
  }
}
